{
    "files.insertFinalNewline": true,
    "files.exclude": {
        "**/.git": true,
        "**/.svn": true,
        "**/.hg": true,
        "**/CVS": true,
        "**/.DS_Store": true,
        "**/tmp": true
    },
    "[powershell]": {
        "editor.formatOnSave": true
    },
    // -----------------------------------------------  BEGIN: ms-vscode.powershell - Configuration  ------------------------------------------------
    // ----------------------------------------  BEGIN: ms-vscode.powershell - Interface Configuration  ----------------------------------------
    // -----------------------------------------------------  Editor Assistance  ------------------------------------------------------
    "powershell.enableReferencesCodeLens": true,
    "powershell.codeFolding.enable": true,
    "powershell.codeFolding.showLastLine": true,
    "powershell.helpCompletion": "BlockComment",
    "powershell.rename.createParameterAlias": true,
    "powershell.rename.acceptDisclaimer": false,
    // -----------------------------------------  END: ms-vscode.powershell - Interface Configuration  -----------------------------------------
    // ----------------------------------------  BEGIN: ms-vscode.powershell - Formatting Configuration  ---------------------------------------
    // ---------------------------------------------------  Spacing and Formatting  ---------------------------------------------------
    "powershell.codeFormatting.whitespaceAroundOperator": true,
    "powershell.codeFormatting.whitespaceAfterSeparator": true,
    "powershell.codeFormatting.whitespaceBeforeOpenBrace": true,
    "powershell.codeFormatting.whitespaceBeforeOpenParen": true,
    "powershell.codeFormatting.whitespaceInsideBrace": true,
    "powershell.codeFormatting.whitespaceBetweenParameters": true,
    "powershell.codeFormatting.addWhitespaceAroundPipe": true,
    "powershell.codeFormatting.trimWhitespaceAroundPipe": true,
    // -----------------------------------------------------  Structural Layout  ------------------------------------------------------
    "powershell.codeFormatting.preset": "OTBS",
    "powershell.codeFormatting.openBraceOnSameLine": true,
    "powershell.codeFormatting.newLineAfterOpenBrace": true,
    "powershell.codeFormatting.newLineAfterCloseBrace": false,
    "powershell.codeFormatting.pipelineIndentationStyle": "IncreaseIndentationForFirstPipeline",
    "powershell.codeFormatting.ignoreOneLineBlock": true,
    // ----------------------------------------------  Optimization and Standardization  ----------------------------------------------
    "powershell.codeFormatting.autoCorrectAliases": true,
    "powershell.codeFormatting.useCorrectCasing": true,
    "powershell.codeFormatting.useConstantStrings": true,
    "powershell.codeFormatting.avoidSemicolonsAsLineTerminators": true,
    "powershell.codeFormatting.alignEnumMemberValues": false,
    "powershell.codeFormatting.alignPropertyValuePairs": false,
    // -----------------------------------------  END: ms-vscode.powershell - Formatting Configuration  ----------------------------------------
    // -------------------------------------  BEGIN: ms-vscode.powershell - Pester Testing Configuration  --------------------------------------
    // -------------------------------------------------  CodeLens & UI Integration  --------------------------------------------------
    "powershell.pester.codeLens": true,
    "powershell.pester.useLegacyCodeLens": false,
    // ---------------------------------------------------  Output Verbosity Logs  ----------------------------------------------------
    "powershell.pester.outputVerbosity": "FromPreference",
    "powershell.pester.debugOutputVerbosity": "Diagnostic",
    // --------------------------------------  END: ms-vscode.powershell - Pester Testing Configuration  ---------------------------------------
    // ------------------------------------------------  END: ms-vscode.powershell - Configuration  -------------------------------------------------
    "json.schemas": [
        {
            "url": "https://raw.githubusercontent.com/ScoopInstaller/Scoop/master/schema.json",
            "fileMatch": [
                "bucket/**/*.json"
            ]
        }
    ]
}
