{
    "version": "1.0.8.3",
    "description": "Wagnardsoft Tools (WTools) is a free system optimization utility for cleaning, repairing, and maintaining Windows, featuring system cleanup, component repair, system management, performance optimization, and more.",
    "homepage": "https://www.wagnardsoft.com/wtools",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://download.wagnardsoft.com/WTools/WTools%20v1.0.8.3.exe#/WTools-1.0.8.3.exe",
            "hash": "fb2b4c486abf216a9af76cc6c6dcfdbff59d424701033a6a3725a1d88722c7df"
        }
    },
    "pre_install": [
        "if (-not (Test-Path -Path \"$persist_dir\\settings\\*\" -PathType Leaf)) {",
        "    $settings_file = \"$persist_dir\\settings\\options.cfg\"",
        "    New-Item -Path $settings_file -ItemType File -Force | Out-Null",
        "    $cfg = [ordered]@{ 'AutoUpdate' = $false; 'FirstLaunch' = $false; 'ManualUpdate' = $false }",
        "    $cfg | ConvertTo-Json -Depth 5 | Set-Content -Path $settings_file -NoNewline -Encoding utf8",
        "}"
    ],
    "installer": {
        "script": "Expand-7zipArchive -Path \"$dir\\$fname\" -ExtractDir \"WTools v$version\" -Overwrite 'Skip' -Removal"
    },
    "shortcuts": [
        [
            "WTools.exe",
            "WTools - Wagnardsoft Tools"
        ]
    ],
    "persist": [
        "logs",
        "settings",
        "Monitoring Export"
    ],
    "checkver": {
        "script": [
            "if ($page -match 'href=\"(?<string>[^\"]+)\">Download[^\\d]+(?<version>[\\d.]+)<') {",
            "    $version = $Matches['version']",
            "    $release_url = 'https://www.wagnardsoft.com/{0}' -f $Matches['string'].TrimStart('/')",
            "    $release_page = Invoke-WebRequest -Uri $release_url -UseBasicParsing -ErrorAction Stop",
            "    if ($release_page.Content -match 'href=\"(?<url>[^\"]+)\".+?DOWNLOAD &amp; SUPPORT') {",
            "        Write-Output \"$($Matches['url']), $version\"",
            "    }",
            "}"
        ],
        "regex": "(?<=\\?t=)(?<topic>\\w+), ([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.wagnardsoft.com/WTools/WTools%20v$version.exe#/WTools-$version.exe"
            }
        },
        "hash": {
            "url": "https://www.wagnardsoft.com/forums/viewtopic.php?t=$matchTopic",
            "regex": "(?s)Portable.+?SHA-256.+?$sha256.+?Portable"
        }
    }
}
