{
    "version": "1.0.4.6",
    "description": "Intelligent Standby List Cleaner (ISLC) is a lightweight memory optimization utility that automatically manages the Windows standby memory list to improve system responsiveness and reduce memory-related performance issues.",
    "homepage": "https://www.wagnardsoft.com/intelligent-standby-list-cleaner",
    "license": "Freeware",
    "url": "https://download.wagnardsoft.com/ISLC/ISLC%20v1.0.4.6.exe#/ISLC-1.0.4.6.exe",
    "hash": "606dcba965af417d97486b125723bbc5cce92f830c7791def06b0c542a10df50",
    "pre_install": [
        "# Hard links are not applicable here because the application creates a new file instead of modifying the existing one in place.",
        "ensure $persist_dir | Out-Null",
        "if ($cmd -eq 'install' -and -not (Test-Path -Path \"$persist_dir\\*\")) { return }",
        "if (Test-Path -Path \"$persist_dir\\config.json\" -PathType Leaf) {",
        "    Copy-Item -Path \"$persist_dir\\config.json\" -Destination \"$dir\\config.json\" -Force",
        "}"
    ],
    "installer": {
        "script": "Expand-7zipArchive -Path \"$dir\\$fname\" -ExtractDir \"ISLC v$version\" -Overwrite 'Skip' -Removal"
    },
    "shortcuts": [
        [
            "Intelligent standby list cleaner ISLC.exe",
            "ISLC - Intelligent Standby List Cleaner"
        ]
    ],
    "pre_uninstall": [
        "# Hard links are not applicable here because the application creates a new file instead of modifying the existing one in place.",
        "if ($cmd -eq 'uninstall' -and $purge) { return }",
        "if (Test-Path -Path \"$dir\\config.json\" -PathType Leaf) {",
        "    Copy-Item -Path \"$dir\\config.json\" -Destination \"$persist_dir\\config.json\" -Force",
        "}"
    ],
    "checkver": {
        "script": [
            "if ($page -match 'href=\"(?<string>[^\"]+)\">Download[^\\d]+(?<version>[\\d.]+)<') {",
            "    $version = $Matches['version']",
            "    $release_url = 'https://www.wagnardsoft.com/{0}' -f $Matches['string'].TrimStart('/')",
            "    $release_page = Invoke-WebRequest -Uri $release_url -UseBasicParsing -ErrorAction Stop",
            "    if ($release_page.Content -match 'href=\"(?<url>[^\"]+)\".+?DOWNLOAD &amp; SUPPORT') {",
            "        Write-Output \"$($Matches['url']), $version\"",
            "    }",
            "}"
        ],
        "regex": "(?<=\\?t=)(?<topic>\\w+), ([\\d.]+)"
    },
    "autoupdate": {
        "url": "https://download.wagnardsoft.com/ISLC/ISLC%20v$version.exe#/ISLC-$version.exe",
        "hash": {
            "url": "https://www.wagnardsoft.com/forums/viewtopic.php?t=$matchTopic",
            "regex": "(?s)Portable.+?SHA-256.+?$sha256.+?Portable"
        }
    }
}
