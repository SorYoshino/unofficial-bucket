{
    "version": "150.0.7871.255-r2",
    "description": "An up-to-date Chromium-based web browser compatible with Windows Vista, 7 and 8.x.",
    "homepage": "https://win32subsystem.live/supermium/",
    "license": {
        "identifier": "BSD-3-Clause",
        "url": "https://github.com/win32ss/supermium/blob/HEAD/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/win32ss/supermium/releases/download/v150-r2/supermium_150_64_setup_win10_11.exe#/Supermium-150.0.7871.255-r2-x86_64-Setup.exe",
            "hash": "17b2183df32aaad0fce6cc51e2058c1f227a0c65ed7b97653e08dbb8ec58d7e8"
        },
        "32bit": {
            "url": "https://github.com/win32ss/supermium/releases/download/v150-r2/supermium_150_32_setup.exe#/Supermium-150.0.7871.255-r2-i686-Setup.exe",
            "hash": "b494f5b6e43cc3074c361a4232f5ad0a944980c83dec28fd599067227d73adf5"
        }
    },
    "pre_install": [
        "ensure \"$persist_dir\\User Data\" | Out-Null",
        "$original_data_dir = \"$env:LocalAppData\\Supermium\\User Data\"",
        "if (-not (Test-Path -Path \"$persist_dir\\User Data\\*\") -and (Test-Path -Path \"$original_data_dir\\*\")) {",
        "    Write-Host \"`nINFO  Migrating user data to '$persist_dir\\User Data'...\" -ForegroundColor DarkGray",
        "    Copy-Item -Path \"$original_data_dir\\*\" -Destination \"$persist_dir\\User Data\" -Force -Recurse",
        "}",
        "Remove-Item -Path \"$env:LocalAppData\\Supermium\" -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "installer": {
        "script": "Expand-7zipArchive -Path \"$dir\\$fname\" -ExtractDir 'Supermium' -Switches '-xr!$* -xr!unins*' -Removal"
    },
    "env_set": {
        "CHROME_EXECUTABLE": "$dir\\chrome.exe"
    },
    "bin": [
        [
            "chrome.exe",
            "supermium",
            "--user-data-dir=\"$dir\\User Data\""
        ]
    ],
    "shortcuts": [
        [
            "chrome.exe",
            "Supermium",
            "--user-data-dir=\"$dir\\User Data\""
        ]
    ],
    "persist": "User Data",
    "checkver": {
        "github": "https://api.github.com/repos/win32ss/supermium/releases/latest",
        "script": [
            "$release = $page | ConvertFrom-Json -ErrorAction Stop",
            "Write-Output \"$($release.tag_name), $($release.name)\""
        ],
        "regex": "(?i)(?<tag>v?[\\d]+(?<suffix>-[^,]+)?),.+?(?<prefix>[\\d.]+)",
        "replace": "${prefix}${suffix}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/win32ss/supermium/releases/download/$matchTag/supermium_$majorVersion_64_setup_win10_11.exe#/Supermium-$version-x86_64-Setup.exe"
            },
            "32bit": {
                "url": "https://github.com/win32ss/supermium/releases/download/$matchTag/supermium_$majorVersion_32_setup.exe#/Supermium-$version-i686-Setup.exe"
            }
        }
    }
}
