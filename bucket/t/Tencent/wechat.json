{
    "version": "4.1.11.23",
    "description": "A free messaging and calling application by Tencent, featuring group chats, multimedia sharing, and more.",
    "homepage": "https://www.wechat.com",
    "license": {
        "identifier": "Proprietary",
        "url": "https://www.wechat.com/en/service_terms.html"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/cscnk52/wechat-windows-versions/releases/download/v4.1.11.23/weixin_4.1.11.23.exe",
            "hash": "905617f03d8cae692f7c18b48be378de33cc6d72fceee766f84ab0d838f5e168"
        }
    },
    "pre_install": [
        "ensure \"$persist_dir\\xwechat_files\" | Out-Null",
        "$config_file = \"$env:APPDATA\\Tencent\\xwechat\\config\\51a1fffea11325a1e4104c6b3de47af7.ini\"",
        "if (-not (Test-Path -Path \"$config_file\" -PathType Leaf)) {",
        "    New-Item -Path $config_file -ItemType File -Force | Out-Null",
        "} else {",
        "    $data_dir = Get-Content -Path $config_file -Encoding utf8",
        "    if ($data_dir -eq $persist_dir) { return }",
        "    if (-not (Test-Path -Path \"$persist_dir\\xwechat_files\\*\") -and `",
        "            $null -ne $data_dir -and (Test-Path -Path \"$data_dir\\xwechat_files\\*\")) {",
        "        Write-Host \"`nINFO  Migrating WeChat data to '$persist_dir\\xwechat_files'...\" -ForegroundColor DarkGray",
        "        Copy-Item -Path \"$data_dir\\xwechat_files\\*\" -Destination \"$persist_dir\\xwechat_files\" -Force -Recurse",
        "        Remove-Item -Path \"$data_dir\\xwechat_files\" -Recurse -Force -ErrorAction SilentlyContinue",
        "    }",
        "}",
        "Set-Content -Path $config_file -Value $persist_dir -NoNewline -Encoding utf8"
    ],
    "installer": {
        "script": [
            "Expand-7zipArchive -Path \"$dir\\$fname\" -Switches '-xr!$*' -Removal",
            "Expand-7zipArchive -Path \"$dir\\install.7z\" -Switches '-xr!unins* -xr!Wetype*' -Removal"
        ]
    },
    "bin": "Weixin.exe",
    "shortcuts": [
        [
            "Weixin.exe",
            "WeChat"
        ]
    ],
    "persist": "xwechat_files",
    "checkver": {
        "github": "https://api.github.com/repos/cscnk52/wechat-windows-versions/releases/latest"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/cscnk52/wechat-windows-versions/releases/download/v$version/weixin_$version.exe"
            }
        }
    }
}
