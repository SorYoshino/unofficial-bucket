{
    "version": "1.13.2",
    "description": "A cross-platform, open-source MQTT 5.0 client engineered to streamline the development and testing of MQTT-based services and applications.",
    "homepage": "https://mqttx.app",
    "license": {
        "identifier": "Apache-2.0",
        "url": "https://github.com/emqx/MQTTX/blob/HEAD/LICENSE"
    },
    "notes": [
        "ARM64 architecture has been temporarily removed from the manifest due to compatibility issues observed on Windows 11 ARM devices.",
        "For more details, see the upstream discussion: https://github.com/emqx/MQTTX/issues/1803#issuecomment-2962059492.",
        "Once the upstream provides a stable ARM64 version, support for this architecture will be re-added to the manifest."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/emqx/MQTTX/releases/download/v1.13.2/MQTTX-Setup-1.13.2-x64.exe",
            "hash": "sha512:026ce944be75aafd0fa2cef225ef51ac9edf560104a21322633312a30dc86e37a494f0c2b8ad2e14d347aa676b9e20616d11c57be9fdadf07f719f6cb0b957de"
        },
        "32bit": {
            "url": "https://github.com/emqx/MQTTX/releases/download/v1.13.2/MQTTX-Setup-1.13.2-ia32.exe",
            "hash": "sha512:7cfee4244b09139dd426a0199fbd18270fcf46bff20c56d0662bcf534ce1375359a79311c9be449077c4dd0b6d013106df9c6169e40f235b4b8ce9745f092e56"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive -Path \"$dir\\$fname\" -DestinationPath \"$dir\\tmp\" -ExtractDir '$PLUGINSDIR' -Removal",
            "Get-ChildItem -Path \"$dir\\tmp\" -Filter '*.7z' -File | Expand-7zipArchive -DestinationPath $dir -Removal",
            "Remove-Item -Path \"$dir\\tmp\" -Recurse -Force -ErrorAction SilentlyContinue"
        ]
    },
    "shortcuts": [
        [
            "MQTTX.exe",
            "MQTT X"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/emqx/MQTTX/releases/latest"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/emqx/MQTTX/releases/download/v$version/MQTTX-Setup-$version-x64.exe"
            },
            "32bit": {
                "url": "https://github.com/emqx/MQTTX/releases/download/v$version/MQTTX-Setup-$version-ia32.exe"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?s)$basename.+?sha512:\\s+$base64"
        }
    }
}
