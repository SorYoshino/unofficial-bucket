            "Firemin"
        ]
    ],
    "persist": "Firemin.ini",
    "checkver": "(?si)Version:.+>([\\d.]+)<.+href=\"https://rizonesoft.com/(?<string>[^\"]+)\".+title=\"Firemin\"",
