                    "PotPlayer.exe",
                    "PotPlayer"
                ],
                [
                    "PotPlayerMini.exe",
                    "PotPlayer Mini"
                ]
            ]
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive -Path \"$dir\\$fname\" -Switches '-xr!$* -xr!*XP* -xr!unins*' -Removal",
            "$arch_flag = if ($architecture -eq '64bit') { '64' } else { '' }",
            "$cfg = @('[Settings]', 'AutoUpdateStart=0', 'CheckAutoUpdate=0', 'AutoDownloadFile=0')",
            "'PotPlayer', 'PotPlayerMini' | ForEach-Object -Process {",
            "    $setting_name = \"$_{0}.ini\" -f $arch_flag",
            "    if (-not (Test-Path -Path \"$persist_dir\\$setting_name\" -PathType Leaf)) {",
            "        Set-Content -Path \"$dir\\$setting_name\" -Value $cfg -Encoding unicode",
            "    }",
            "    persist_data @{ persist = $setting_name } $dir $persist_dir",
            "    persist_permission @{ persist = $setting_name } $global",
            "}"
        ]
    },
    "post_install": [
        "'Logos', 'Skins', 'Module', 'UrlList', 'IconPack', 'PxShader', 'Extension' | ForEach-Object -Process {",
        "    $original_data_dir = \"$dir\\$_.original\"",
        "    if (Test-Path -Path $original_data_dir -PathType Container) {",
        "        Copy-Item -Path \"$original_data_dir\\*\" -Destination \"$dir\\$_\" -Force -Recurse",
        "        Remove-Item -Path $original_data_dir -Recurse -Force -ErrorAction SilentlyContinue",
        "    }",
        "}"
    ],
    "persist": [
        "Logos",
        "Model",
        "Skins",
        "Engine",
        "Module",
        "Capture",
        "Playlist",
        "UrlList",
        "IconPack",
        "PxShader",
        "Extension",
        "Extention"
    ],
    "uninstaller": {
        "script": [
            "$arch_flag = if ($architecture -eq '64bit') { '64' } else { '' }",
            "'PotPlayer', 'PotPlayerMini' | ForEach-Object -Process {",
            "    $setting_name = \"$_{0}.ini\" -f $arch_flag",
            "    unlink_persist_data @{ persist = $setting_name } $dir",
            "}"
        ]
    },
    "checkver": {
        "url": "https://t1.kakaocdn.net/potplayer/PotPlayer/v4/Update2/UpdateEng.html",
        "script": [
            "if ($page -match '\\[(?<tag>\\d+)\\]') {",
            "    $download_url = 'https://t1.kakaocdn.net/potplayer/PotPlayer/Version/{0}/PotPlayerSetup64.exe' -f $Matches['tag']",
            "    $download_path = cache_path $app 'unknown' $download_url",
            "    Invoke-WebRequest -Uri $download_url -OutFile $download_path -UseBasicParsing",
            "    $version_info = [System.Diagnostics.FileVersionInfo]::GetVersionInfo($download_path)",
            "    $final_download_url = '{0}#/PotPlayer-{1}-x86_64-Setup.exe' -f $download_url, $version_info.FileVersion",
            "    Move-Item -Path $download_path -Destination (cache_path $app $version_info.FileVersion $final_download_url) -Force",
            "    Write-Output \"$($version_info.FileVersion), $($Matches['tag'])\"",
            "}"
        ],
        "regex": "([\\d.]+), (?<tag>\\d+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://t1.kakaocdn.net/potplayer/PotPlayer/Version/$matchTag/PotPlayerSetup64.exe#/PotPlayer-$version-x86_64-Setup.exe"
            },
            "32bit": {
                "url": "https://t1.kakaocdn.net/potplayer/PotPlayer/Version/$matchTag/PotPlayerSetup.exe#/PotPlayer-$version-i686-Setup.exe"
            }
        }
    }
}
