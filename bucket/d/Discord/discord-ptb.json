{
    "version": "1.0.1211",
    "description": "A voice, video, and text communication platform, offering early access to the newest features via the Public Test Build (PTB) prior to their general release.",
    "homepage": "https://discord.com",
    "license": {
        "identifier": "Freeware",
        "url": "https://discord.com/terms"
    },
    "architecture": {
        "64bit": {
            "url": "https://ptb.dl2.discordapp.net/distro/app/ptb/win/x64/1.0.1211/DiscordPTBSetup.exe#/DiscordPTB-1.0.1211-x86_64-Setup.exe",
            "hash": "1cc049d5b9a1f223e7019e65aecd068a58956596e06af8a26fea8c0f0491ff61"
        }
    },
    "installer": {
        "script": [
            "ensure \"$dir\\packages\" | Out-Null",
            "Expand-7zipArchive -Path \"$dir\\$fname\" -Removal",
            "$archive_file = Get-ChildItem -Path $dir -Filter '*.nupkg' -File | ForEach-Object -MemberName FullName",
            "Expand-7zipArchive -Path $archive_file -DestinationPath \"$dir\\app-$version\" -ExtractDir 'lib\\net45' -Removal",
            "Move-Item -Path \"$dir\\app-$version\\installer.db\" -Destination $dir -Force",
            "Move-Item -Path \"$dir\\RELEASES\" -Destination \"$dir\\packages\" -Force",
            "Copy-Item -Path \"$dir\\app-$version\\app.ico\" -Destination $dir -Force"
        ]
    },
    "shortcuts": [
        [
            "Update.exe",
            "Discord PTB",
            "--processStart DiscordPTB.exe",
            "app.ico"
        ]
    ],
    "checkver": {
        "url": "https://updates.discord.com/distributions/app/manifests/latest?channel=ptb&platform=win&arch=x64",
        "regex": "x64/([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://ptb.dl2.discordapp.net/distro/app/ptb/win/x64/$version/DiscordPTBSetup.exe#/DiscordPTB-$version-x86_64-Setup.exe"
            }
        }
    }
}
