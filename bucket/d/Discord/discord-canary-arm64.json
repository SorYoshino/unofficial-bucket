{
    "version": "1.0.516",
    "description": "A voice, video, and text communication platform for ARM64, serving as the bleeding-edge testing environment for the latest features and architectural updates.",
    "homepage": "https://discord.com",
    "license": {
        "identifier": "Freeware",
        "url": "https://discord.com/terms"
    },
    "architecture": {
        "64bit": {
            "url": "https://canary.dl2.discordapp.net/distro/app/canary/win/arm64/1.0.516/DiscordCanarySetup.exe#/DiscordCanary-1.0.516-aarch64-Setup.exe",
            "hash": "41620990b42ddcc00f55cb286a8f36a4fd56f9513d5daa63765606d31b74de8a"
        }
    },
    "installer": {
        "script": [
            "ensure \"$dir\\packages\" | Out-Null",
            "Expand-7zipArchive -Path \"$dir\\$fname\" -Removal",
            "$archive_file = Get-ChildItem -Path $dir -Filter '*.nupkg' -File | ForEach-Object -MemberName FullName",
            "Expand-7zipArchive -Path $archive_file -DestinationPath \"$dir\\app-$version\" -ExtractDir 'lib\\net45' -Removal",
            "Move-Item -Path \"$dir\\app-$version\\installer.db\" -Destination $dir -Force",
            "Move-Item -Path \"$dir\\RELEASES\" -Destination \"$dir\\packages\" -Force",
            "Copy-Item -Path \"$dir\\app-$version\\app.ico\" -Destination $dir -Force"
        ]
    },
    "shortcuts": [
        [
            "Update.exe",
            "Discord Canary",
            "--processStart DiscordCanary.exe",
            "app.ico"
        ]
    ],
    "checkver": {
        "url": "https://updates.discord.com/distributions/app/manifests/latest?channel=canary&platform=win&arch=arm64",
        "regex": "arm64/([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://canary.dl2.discordapp.net/distro/app/canary/win/arm64/$version/DiscordCanarySetup.exe#/DiscordCanary-$version-aarch64-Setup.exe"
            }
        }
    }
}
