{
    "version": "1.0.1009",
    "description": "A voice, video, and text communication platform for ARM64, providing access to the most internal and unrefined builds for development and testing purposes.",
    "homepage": "https://discord.com",
    "license": {
        "identifier": "Freeware",
        "url": "https://discord.com/terms"
    },
    "architecture": {
        "64bit": {
            "url": "https://development.dl2.discordapp.net/distro/app/development/win/arm64/1.0.1009/DiscordDevelopmentSetup.exe#/DiscordDevelopment-1.0.1009-aarch64-Setup.exe",
            "hash": "e08eaf2b64f0e25a132c9c5c6f480d28a9f3bf349310147794fe1ceb3e93e78f"
        }
    },
    "installer": {
        "script": [
            "ensure \"$dir\\packages\" | Out-Null",
            "Expand-7zipArchive -Path \"$dir\\$fname\" -Removal",
            "$archive_file = Get-ChildItem -Path $dir -Filter '*.nupkg' -File | ForEach-Object -MemberName FullName",
            "Expand-7zipArchive -Path $archive_file -DestinationPath \"$dir\\app-$version\" -ExtractDir 'lib\\net45' -Removal",
            "Move-Item -Path \"$dir\\app-$version\\installer.db\" -Destination $dir -Force",
            "Move-Item -Path \"$dir\\RELEASES\" -Destination \"$dir\\packages\" -Force",
            "Copy-Item -Path \"$dir\\app-$version\\app.ico\" -Destination $dir -Force"
        ]
    },
    "shortcuts": [
        [
            "Update.exe",
            "Discord Development",
            "--processStart DiscordDevelopment.exe",
            "app.ico"
        ]
    ],
    "checkver": {
        "url": "https://updates.discord.com/distributions/app/manifests/latest?channel=development&platform=win&arch=arm64",
        "regex": "arm64/([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://development.dl2.discordapp.net/distro/app/development/win/arm64/$version/DiscordDevelopmentSetup.exe#/DiscordDevelopment-$version-aarch64-Setup.exe"
            }
        }
    }
}
