{
    "version": "1.0.1036",
    "description": "A voice, video, and text communication platform, providing access to the most internal and unrefined builds for development and testing purposes.",
    "homepage": "https://discord.com",
    "license": {
        "identifier": "Freeware",
        "url": "https://discord.com/terms"
    },
    "architecture": {
        "64bit": {
            "url": "https://development.dl2.discordapp.net/distro/app/development/win/x64/1.0.1036/DiscordDevelopmentSetup.exe#/DiscordDevelopment-1.0.1036-x86_64-Setup.exe",
            "hash": "6a3e5817bfcf5e0144287539a22e8b66a6f5d103078bf57c5877b41430e186d7"
        }
    },
    "installer": {
        "script": [
            "ensure \"$dir\\packages\" | Out-Null",
            "Expand-7zipArchive -Path \"$dir\\$fname\" -Removal",
            "$archive_file = Get-ChildItem -Path $dir -Filter '*.nupkg' -File | ForEach-Object -MemberName FullName",
            "Expand-7zipArchive -Path $archive_file -DestinationPath \"$dir\\app-$version\" -ExtractDir 'lib\\net45' -Removal",
            "Move-Item -Path \"$dir\\app-$version\\installer.db\" -Destination $dir -Force",
            "Move-Item -Path \"$dir\\RELEASES\" -Destination \"$dir\\packages\" -Force",
            "Copy-Item -Path \"$dir\\app-$version\\app.ico\" -Destination $dir -Force"
        ]
    },
    "shortcuts": [
        [
            "Update.exe",
            "Discord Development",
            "--processStart DiscordDevelopment.exe",
            "app.ico"
        ]
    ],
    "checkver": {
        "url": "https://updates.discord.com/distributions/app/manifests/latest?channel=development&platform=win&arch=x64",
        "regex": "x64/([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://development.dl2.discordapp.net/distro/app/development/win/x64/$version/DiscordDevelopmentSetup.exe#/DiscordDevelopment-$version-x86_64-Setup.exe"
            }
        }
    }
}
