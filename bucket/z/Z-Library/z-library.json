{
    "version": "3.2.1",
    "description": "A shadow library project for file-sharing access to scholarly journal articles, academic texts and general-interest books.",
    "homepage": "https://z-lib.sk",
    "license": "Freeware",
    "architecture": {
        "64bit": {
            "url": "https://s3proxy-alp.cdn-zlib.sk/swfs_second_public_files/soft/desktop/Z-Library-latest.exe#/Z-Library-3.2.1-x86_64-Setup.exe",
            "hash": "5fbd0105e79a6da46afd3a11dafa961aa2b1c493df769fa39abd8140151aef9f"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive -Path \"$dir\\$fname\" -DestinationPath \"$dir\\tmp\" -ExtractDir '$PLUGINSDIR' -Removal",
            "Get-ChildItem -Path \"$dir\\tmp\" -Filter '*.7z' -File | Expand-7zipArchive -DestinationPath $dir -Removal",
            "Remove-Item -Path \"$dir\\tmp\" -Recurse -Force -ErrorAction SilentlyContinue"
        ]
    },
    "shortcuts": [
        [
            "Z-Library.exe",
            "Z-Library"
        ]
    ],
    "checkver": {
        "script": [
            "$download_url = 'https://s3proxy-alp.cdn-zlib.sk/swfs_second_public_files/soft/desktop/Z-Library-latest.exe'",
            "$download_path = cache_path $app 'unknown' $download_url",
            "Invoke-WebRequest -Uri $download_url -OutFile $download_path -UseBasicParsing",
            "$version_info = [System.Diagnostics.FileVersionInfo]::GetVersionInfo($download_path)",
            "$final_download_url = '{0}#/Z-Library-{1}-x86_64-Setup.exe' -f $download_url, $version_info.FileVersion",
            "Move-Item -Path $download_path -Destination (cache_path $app $version_info.ProductVersion $final_download_url) -Force",
            "Write-Output $version_info.ProductVersion"
        ],
        "regex": "([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://s3proxy-alp.cdn-zlib.sk/swfs_second_public_files/soft/desktop/Z-Library-latest.exe#/Z-Library-$version-x86_64-Setup.exe"
            }
        }
    }
}
