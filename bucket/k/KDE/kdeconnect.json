{
    "version": "26.08-6558",
    "description": "A cross-platform utility that enables communication and data transfer over local networks, supporting file exchange, clipboard sharing, notification synchronization, remote interaction, and other related capabilities.",
    "homepage": "https://kdeconnect.kde.org",
    "license": {
        "identifier": "GPL-2.0-or-later",
        "url": "https://invent.kde.org/network/kdeconnect-kde/-/blob/HEAD/LICENSES/GPL-2.0-or-later.txt"
    },
    "architecture": {
        "64bit": {
            "url": "https://cdn.kde.org/ci-builds/network/kdeconnect-kde/release-26.08/windows/kdeconnect-kde-release_26.08-6558-windows-cl-msvc2022-x86_64.7z",
            "hash": "312209bfef47804dd9f262994dbe346c3993fd4a8713ad19bac95bbb5e2d7993"
        }
    },
    "bin": "bin\\kdeconnect-cli.exe",
    "shortcuts": [
        [
            "bin\\kdeconnect-app.exe",
            "KDEConnect"
        ]
    ],
    "checkver": {
        "script": [
            "$app, $app_type = 'kdeconnect-kde', 'network'",
            "$releases_url = 'https://cdn.kde.org/ci-builds/{1}/{0}/' -f $app, $app_type",
            "$version_sort = { if ($_.href -match '([\\d.]+)/$') { [version]$Matches[1] } }",
            "$releases_page = Invoke-WebRequest -Uri $releases_url -UseBasicParsing -ErrorAction Stop",
            "$path_segments = $releases_page.links | Where-Object -FilterScript { $_.href -like 'release-*/' } |",
            "        Sort-Object -Property $version_sort -Descending | ForEach-Object -MemberName href",
            "foreach ($path_segment in $path_segments.TrimEnd('/')) {",
            "    $release_url = 'https://cdn.kde.org/ci-builds/{1}/{0}/{2}/windows/' -f $app, $app_type, $path_segment",
            "    $response = Invoke-WebRequest -Uri $release_url -UseBasicParsing -SkipHttpErrorCheck -ErrorAction Stop",
            "    if ($null -eq $response -or $response.StatusCode -ne 200) { continue }",
            "    $archive_name = $response.Links | Where-Object -FilterScript { $_.href -match '\\.7z$' } |",
            "            Select-Object -ExpandProperty href -First 1",
            "    if (-not [string]::IsNullOrWhiteSpace($archive_name)) { Write-Output $archive_name; break }",
            "}"
        ],
        "regex": "kdeconnect-kde-release_([\\d.-]+)-windows-cl-(?<lib>\\w+)-x86_64\\.7z"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://cdn.kde.org/ci-builds/network/kdeconnect-kde/release-$matchHead/windows/kdeconnect-kde-release_$version-windows-cl-$matchLib-x86_64.7z",
                "hash": {
                    "url": "$url.sha256"
                }
            }
        }
    }
}
