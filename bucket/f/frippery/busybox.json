{
    "version": "6354-g5f09fb446",
    "description": "A compact Windows port of BusyBox that provides a single native executable implementing a broad set of  Unix-style command-line utilities, suitable for lightweight scripting and command-line use on Windows.",
    "homepage": "https://frippery.org/busybox/index.html",
    "license": {
        "identifier": "GPL-2.0-only",
        "url": "https://github.com/rmyorston/busybox-w32/blob/HEAD/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://frippery.org/files/busybox/busybox-w64u-FRP-6354-g5f09fb446.exe#/busybox.exe",
            "hash": "36b266923fc5765b42f5f981319f39568498fba60b53ccf26e8fc1e575e2a9a9"
        },
        "32bit": {
            "url": "https://frippery.org/files/busybox/busybox-w32-FRP-6354-g5f09fb446.exe#/busybox.exe",
            "hash": "1aa736a5334eb74a3342b74a5cd6e66297cdba6ca6d890e83e7b46afa5b9ce5c"
        },
        "arm64": {
            "url": "https://frippery.org/files/busybox/busybox-w64a-FRP-6354-g5f09fb446.exe#/busybox.exe",
            "hash": "ef426a4967f0a4657343242e85c290a8fb3272c6145c230439c587a0a97f9969"
        }
    },
    "installer": {
        "script": [
            "$process_info = [System.Diagnostics.ProcessStartInfo]@{",
            "    FileName = \"$dir\\busybox.exe\"",
            "    CreateNoWindow = $true; UseShellExecute = $false",
            "    RedirectStandardError = $true; RedirectStandardOutput = $true",
            "}",
            "$process_info.ArgumentList.Add('--list')",
            "try {",
            "    $process = [System.Diagnostics.Process]::Start($process_info)",
            "    $stdout_response = $process.StandardOutput.ReadToEnd()",
            "    $stderr_response = $process.StandardError.ReadToEnd()",
            "    $process.WaitForExit()",
            "    if ($process.ExitCode -ne 0) {",
            "        throw \"Process terminated unexpectedly with exit code $($process.ExitCode). Stderr: $($stderr_response.Trim())\"",
            "    }",
            "} catch {",
            "    Write-Warning \"Execution failed: $($_.Exception.Message)\" ",
            "} finally {",
            "    if ($null -ne $process) { $process.Dispose() }",
            "}",
            "if (-not [string]::IsNullOrWhiteSpace($stdout_response)) {",
            "    Write-Output \"`nCreating shim for 'busybox'....\"",
            "    $utility_names = $stdout_response -split \"`r?`n\" | Where-Object -FilterScript { $_ -notmatch '^([\\s[]|$)' }",
            "    Set-Content -Path \"$dir\\utility_names.ini\" -Value $utility_names -Encoding utf8",
            "    shim \"$dir\\busybox.exe\" $global 'busybox' $null",
            "    $utility_names | ForEach-Object -Process {",
            "        Write-Output \"Creating shim for '$($_.Trim())'...\"",
            "        shim \"$dir\\busybox.exe\" $global $_.Trim() $_.Trim()",
            "    }",
            "} else { abort \"`nShim creation failed: Unable to retrieve utility names from 'busybox --list' output.\" }"
        ]
    },
    "uninstaller": {
        "script": [
            "rm_shim 'busybox' $(shimdir $global) $app",
            "$utility_names = Get-Content -Path \"$dir\\utility_names.ini\" -Encoding utf8",
            "$utility_names | Where-Object -FilterScript { $_ -notmatch '^([\\s[]|$)' } | ForEach-Object -Process {",
            "    rm_shim $_.Trim() $(shimdir $global) $app",
            "}"
        ]
    },
    "checkver": {
        "url": "https://frippery.org/files/busybox/?C=M;O=D",
        "regex": "busybox-w64u-FRP-([\\w-]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://frippery.org/files/busybox/busybox-w64u-FRP-$version.exe#/busybox.exe"
            },
            "32bit": {
                "url": "https://frippery.org/files/busybox/busybox-w32-FRP-$version.exe#/busybox.exe"
            },
            "arm64": {
                "url": "https://frippery.org/files/busybox/busybox-w64a-FRP-$version.exe#/busybox.exe"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUM"
        }
    }
}
