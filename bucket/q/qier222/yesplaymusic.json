{
    "version": "0.4.11",
    "description": "A cloud-based music player built on NetEase Player, offering a refined and elegant user interface.",
    "homepage": "https://music.qier222.com",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/qier222/YesPlayMusic/blob/HEAD/LICENSE"
    },
    "suggest": {
        "Microsoft Visual C++ 2015-2022 Redistributable": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/qier222/YesPlayMusic/releases/download/v0.4.11/YesPlayMusic-Setup-0.4.11.exe",
            "hash": "sha512:31c670ab8bdd9f1a5edd856ceffe1e8cdfd415ed6a40612987849ba23f0a9fa286b8bed7b4e78cd36e0b310af42147cd3804f8325fb4c178400df2efc8f1ad61"
        }
    },
    "installer": {
        "script": [
            "Expand-7zipArchive -Path \"$dir\\$fname\" -DestinationPath \"$dir\\tmp\" -ExtractDir '$PLUGINSDIR' -Removal",
            "Get-ChildItem -Path \"$dir\\tmp\" -Filter '*.7z' -File | Expand-7zipArchive -DestinationPath $dir -Removal",
            "Remove-Item -Path \"$dir\\tmp\" -Recurse -Force -ErrorAction SilentlyContinue"
        ]
    },
    "shortcuts": [
        [
            "YesPlayMusic.exe",
            "YesPlayMusic"
        ]
    ],
    "checkver": {
        "github": "https://api.github.com/repos/qier222/YesPlayMusic/releases/latest",
        "jsonpath": "$.assets[?(@.name =~ /Setup.+exe$/i)].browser_download_url",
        "regex": "download/v([\\d.-]+)/(?<name>[^\"]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/qier222/YesPlayMusic/releases/download/v$version/$matchName"
            }
        },
        "hash": {
            "url": "$baseurl/latest.yml",
            "regex": "(?s)$basename.+?$base64"
        }
    }
}
