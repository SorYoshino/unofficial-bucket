{
    "version": "0.9.0",
    "description": "A cross-platform Rust reimplementation of GNU coreutils (binaries compiled with MSVC), with some options or behaviors potentially differing from GNU coreutils.",
    "homepage": "https://uutils.org/coreutils/",
    "license": {
        "identifier": "MIT",
        "url": "https://github.com/uutils/coreutils/blob/HEAD/LICENSE"
    },
    "suggest": {
        "Microsoft Visual C++ 2015-2022 Redistributable": "extras/vcredist2022"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/uutils/coreutils/releases/download/0.9.0/coreutils-0.9.0-x86_64-pc-windows-msvc.zip",
            "hash": "77b4cad20258b654a75c4cde7f4f7033ea896a71a700f68072ee44599c1d76d4",
            "extract_dir": "coreutils-0.9.0-x86_64-pc-windows-msvc"
        },
        "32bit": {
            "url": "https://github.com/uutils/coreutils/releases/download/0.9.0/coreutils-0.9.0-i686-pc-windows-msvc.zip",
            "hash": "8ea2031e7314e9cf917a000ecc7f9e3ae73bb2ce653218c3fde0c30bdd61b658",
            "extract_dir": "coreutils-0.9.0-i686-pc-windows-msvc"
        },
        "arm64": {
            "url": "https://github.com/uutils/coreutils/releases/download/0.9.0/coreutils-0.9.0-aarch64-pc-windows-msvc.zip",
            "hash": "c792e3949a6a3d91f944b765aab6f0b62cf213e886b347dbb81c66d7e0499d04",
            "extract_dir": "coreutils-0.9.0-aarch64-pc-windows-msvc"
        }
    },
    "post_install": [
        "$program_files = Get-ChildItem -Path $original_dir -Filter '*.exe' -File",
        "if ($program_files.Count -eq 0) { abort \"`nShim creation failed: 'coreutils.exe' could not be found in '$original_dir'.\" }",
        "if ($program_files.Count -eq 1) {",
        "    $process_info = [System.Diagnostics.ProcessStartInfo]@{",
        "        FileName = $program_files.FullName; Arguments = '--list'",
        "        CreateNoWindow = $true; UseShellExecute = $false; RedirectStandardOutput = $true",
        "    }",
        "    $process = [System.Diagnostics.Process]::Start($process_info)",
        "    $stdout_response = $process.StandardOutput.ReadToEnd()",
        "    $process.WaitForExit()",
        "    if (-not [string]::IsNullOrWhiteSpace($stdout_response)) {",
        "        Write-Output \"`nCreating shim for 'coreutils'....\"",
        "        $utility_names = $stdout_response -split \"`r?`n\" | Where-Object -FilterScript { $_ -notmatch '^([\\s[]|$)' }",
        "        shim \"$original_dir\\coreutils.exe\" $global 'coreutils' $null",
        "        $utility_names | ForEach-Object -Process {",
        "            Write-Output \"Creating shim for '$($_.Trim())'...\"",
        "            shim \"$original_dir\\coreutils.exe\" $global $_.Trim() $_.Trim()",
        "        }",
        "        $utility_names = , 'coreutils' + $utility_names",
        "    } else {",
        "        abort \"`nShim creation failed: Unable to retrieve utility names from 'coreutils --list' output.\" ",
        "    }",
        "} else {",
        "    $utilities = $program_files | Where-Object -FilterScript { $_.BaseName -notmatch '^([\\s[]|$)' }",
        "    $utility_names = $utilities | ForEach-Object -MemberName BaseName",
        "    $utilities | Foreach-Object -Process {",
        "        Write-Output \"Creating shim for '$($_.BaseName)'...\"",
        "        shim $_.FullName $global $_.BaseName $null",
        "    }",
        "}",
        "Set-Content -Path \"$original_dir\\utility_names.ini\" -Value $utility_names -Encoding utf8"
    ],
    "uninstaller": {
        "script": [
            "$utility_names = Get-Content -Path \"$dir\\utility_names.ini\" -Encoding utf8",
            "$utility_names | Where-Object -FilterScript { $_ -notmatch '^([\\s[]|$)' } | ForEach-Object -Process {",
            "    rm_shim $_.Trim() $(shimdir $global) $app",
            "}"
        ]
    },
    "checkver": {
        "github": "https://api.github.com/repos/uutils/coreutils/releases/latest"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/uutils/coreutils/releases/download/$version/coreutils-$version-x86_64-pc-windows-msvc.zip",
                "extract_dir": "coreutils-$version-x86_64-pc-windows-msvc"
            },
            "32bit": {
                "url": "https://github.com/uutils/coreutils/releases/download/$version/coreutils-$version-i686-pc-windows-msvc.zip",
                "extract_dir": "coreutils-$version-i686-pc-windows-msvc"
            },
            "arm64": {
                "url": "https://github.com/uutils/coreutils/releases/download/$version/coreutils-$version-aarch64-pc-windows-msvc.zip",
                "extract_dir": "coreutils-$version-aarch64-pc-windows-msvc"
            }
        }
    }
}
