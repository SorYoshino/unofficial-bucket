    "checkver": {
        "url": "https://geeks3d.com/furmark/kombustor/downloads/",
        "script": [
            "if ($page -match 'href=\"/dl/show/([\\d]+)\"(?!.+zip)') {",
            "    $release_url = 'https://geeks3d.com/dl/get/{0}' -f $Matches[1]",
            "    if ($PSVersionTable.PSVersion -lt [version]::new(7, 0)) { Add-Type -AssemblyName System.Net.Http }",
            "    $http_handler = New-Object -TypeName System.Net.Http.HttpClientHandler",
            "    $http_handler.AllowAutoRedirect = $true",
            "    $client = [System.Net.Http.HttpClient]::new($http_handler)",
            "    $request = New-Object -TypeName System.Net.Http.HttpRequestMessage -ArgumentList 'HEAD', $release_url",
            "    $response = $client.SendAsync($request).Result",
            "    $package_name = $response.RequestMessage.RequestUri.AbsoluteUri -replace '.+(?<=/)([^/]+)$', '$1'",
            "    $response, $request, $client, $http_handler | Where-Object -FilterScript { $_ } | ForEach-Object -Process { $_.Dispose() }",
            "    Write-Output \"$release_url, $package_name\"",
            "}"
        ],
        "regex": "get/(?<tag>\\d+), MSI_Kombustor4_Setup_v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://gpuscore.top/msi/MSI_Kombustor4_Setup_v$version_x64.exe",
                "hash": {
                    "url": "https://geeks3d.com/dl/show/$matchTag",
                    "regex": "(?i)sha256.+?$sha256<"
                }
            }
        }
    }
}
