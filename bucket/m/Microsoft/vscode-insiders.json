{
    "version": "1.137.0-2026.245.5.8",
    "description": "Visual Studio Code Insiders is a lightweight yet powerful, cross-platform source code editor providing rich support for development, debugging, and extension-based customization for modern web and cloud workloads.",
    "homepage": "https://code.visualstudio.com/insiders",
    "license": {
        "identifier": "Freeware",
        "url": "https://code.visualstudio.com/license/insiders"
    },
    "notes": [
        "To register file associations, please execute the following command:",
        "- `reg import \"$dir\\register-file-associations.reg\"`",
        "To register the context menu entry, please execute the following command:",
        "- `reg import \"$dir\\register-context-menu.reg\"`"
    ],
    "architecture": {
        "64bit": {
            "url": "https://vscode.download.prss.microsoft.com/dbazure/download/insider/1f625adb84abf41cdff31f40f66e58a222f033f6/VSCode-win32-x64-1.137.0-insider.zip",
            "hash": "2a0c74e78f087d3da1cf7290a902240454d6c54503742019dac83e21ce87fe18"
        },
        "arm64": {
            "url": "https://vscode.download.prss.microsoft.com/dbazure/download/insider/1f625adb84abf41cdff31f40f66e58a222f033f6/VSCode-win32-arm64-1.137.0-insider.zip",
            "hash": "a60278459281a6efdfbc68bf46c6572a19f5b8b3e6a9a1335454082715ef3d6a"
        }
    },
    "pre_install": [
        "ensure \"$persist_dir\\data\\user-data\" | Out-Null",
        "if (-not (Test-Path -Path \"$persist_dir\\data\\user-data\\*\") -and (Test-Path -Path \"$env:AppData\\Code - Insiders\\*\")) {",
        "    Write-Host \"`nINFO  Migrating user data to '$persist_dir\\data'...\" -ForegroundColor DarkGray",
        "    Copy-Item -Path \"$env:AppData\\Code - Insiders\\*\" -Destination \"$persist_dir\\data\\user-data\" -Force -Recurse",
        "}",
        "'argv.json', 'extensions' | ForEach-Object -Process {",
        "    if (-not (Test-Path -Path \"$persist_dir\\data\\$_\") -and (Test-Path -Path \"$HOME\\.vscode-insiders\\$_\")) {",
        "        Write-Host \"INFO  Migrating $_ to '$persist_dir\\data'...\" -ForegroundColor DarkGray",
        "        Copy-Item -Path \"$HOME\\.vscode-insiders\\$_\" -Destination \"$persist_dir\\data\" -Force -Recurse",
        "    }",
        "}",
        "$remove_list = @('argv.json', 'extensions') | ForEach-Object -Process { \"$HOME\\.vscode-insiders\\$_\" }",
        "$remove_list + @(\"$env:AppData\\Code - Insiders\") | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue",
        "$settings_file = \"$persist_dir\\data\\user-data\\User\\settings.json\"",
        "if (-not (Test-Path -Path $settings_file -PathType Leaf)) {",
        "    New-Item -Path $settings_file -ItemType File -Force | Out-Null",
        "    $settings = @{ 'update.mode'= 'none'; 'update.enableWindowsBackgroundUpdates' = $false }",
        "    $settings | ConvertTo-Json -Depth 5 | Set-Content -Path $settings_file -NoNewline -Encoding utf8",
        "}"
    ],
    "installer": {
        "script": [
            "startmenu_shortcut \"$dir\\Code - Insiders.exe\" 'Visual Studio Code - Insiders' $null $null $global",
            "persist_data @{ persist = @('data') } $dir  $persist_dir",
            "persist_permission @{ persist = @('data') } $global"
        ]
    },
    "post_install": [
        "$vscode_insiders_dir = $original_dir -replace '\\\\', '\\\\'",
        "$product_json_file = Get-ChildItem -Path $dir -Include '*.json' -Depth 3 -File |",
        "        Where-Object -FilterScript { $_.DirectoryName -match 'app$' -and $_.BaseName -match '^product' } |",
        "        Select-Object -ExpandProperty FullName -First 1",
        "if (Test-Path -Path $product_json_file -PathType Leaf) {",
        "    $scope = if ($global) { '' } else { 'User' }",
        "    $arch_map = @{ '64bit' = 'x64'; 'arm64' = 'arm64' }",
        "    $product_metadata = Get-Content -Path $product_json_file -Encoding utf8 | ConvertFrom-Json",
        "    $product_property_key = 'win32{0}{1}AppId' -f $arch_map[$architecture], $scope",
        "    $product_identity_guid = $product_metadata.$product_property_key.Trim('{', '}')",
        "}",
        "Get-ChildItem -Path \"$bucketsdir\\$bucket\\scripts\\$app\" -Filter '*.reg' -File | ForEach-Object -Process {",
        "    $content = Get-Content -Path $_.FullName -Encoding utf8",
        "    if ($global) { $content = $content -replace 'HKEY_CURRENT_USER', 'HKEY_LOCAL_MACHINE' }",
        "    if ($product_identity_guid) { $content = $content -replace '(?<={).+(?=}_is1)', $product_identity_guid }",
        "    $content -replace '{{vscode_insiders_dir}}', $vscode_insiders_dir | Set-Content -Path \"$dir\\$($_.Name)\" -Encoding unicode",
        "}",
        "Write-Output \"`nAdding '$(friendly_path \"$original_dir\\bin\")' to $(if ($global) { 'global' } else { 'your' }) path...\"",
        "Add-Path -Path \"$original_dir\\bin\" -Global:$global -Quiet -Force",
        "ensure \"$dir\\resources\\app\\resources\\win32\" | Out-Null",
        "$original_resources_dir = Get-ChildItem -Path $dir -Include '*.ico' -Depth 5 -File |",
        "        Where-Object -FilterScript { $_.DirectoryName -match 'resources\\\\win32$' } |",
        "        Select-Object -ExpandProperty DirectoryName -First 1",
        "Copy-Item -Path \"$original_resources_dir\\*\" -Destination \"$dir\\resources\\app\\resources\\win32\" -Force",
        "$data_dir = \"$original_dir\\data\" -replace '\\\\', '/'",
        "$extensions_file = \"$dir\\data\\extensions\\extensions.json\"",
        "if (Test-Path -Path $extensions_file -PathType Leaf) {",
        "    Write-Host \"INFO  Adjusting path in extensions file...\" -ForegroundColor DarkGray",
        "    $cfg = Get-Content -Path $extensions_file -Encoding utf8 | ConvertFrom-Json",
        "    $cfg | ForEach-Object -Process {",
        "        $_.location.PSObject.Properties.Remove('_sep')",
        "        $_.location.PSObject.Properties.Remove('fsPath')",
        "        $_.location.PSObject.Properties.Remove('external')",
        "        $_.location.path = $_.location.path -replace '(?<=/).+(?=/extensions)', $data_dir",
        "        if (-not $_.identifier.uuid -and $_.metadata.id) {",
        "            $_.identifier | Add-Member -NotePropertyName uuid -NotePropertyValue $_.metadata.id",
        "        }",
        "    }",
        "    , @($cfg) | ConvertTo-Json -Depth 5 -Compress | Set-Content -Path $extensions_file -NoNewline -Encoding utf8",
        "}",
        "$registry_hive = if ($global) { 'HKLM' } else { 'HKCU' }",
        "$register_installed_file = '\"{0}\\register-installed-program.reg\"' -f $dir",
        "Start-Process -FilePath 'reg.exe' -ArgumentList @('import', $register_installed_file) -WindowStyle Hidden -Wait",
        "@(",
        "    @{ Path = \"${registry_hive}:\\Software\\Classes\\VSCodeInsiders.*\"; IsLiteral = $false; File = 'register-file-associations.reg' }",
        "    @{ Path = \"${registry_hive}:\\Software\\Classes\\*\\shell\\VSCodeInsiders\"; IsLiteral = $true; File = 'register-context-menu.reg' }",
        ") | ForEach-Object -Process {",
        "    $is_match = if ($_.IsLiteral) { Test-Path -LiteralPath $_.Path } else { Test-Path -Path $_.Path }",
        "    if ($is_match) {",
        "        $registry_file = '\"{0}\\{1}\"' -f $original_dir, $_.File",
        "        Start-Process -FilePath 'reg.exe' -ArgumentList @('import', $registry_file) -WindowStyle Hidden -Wait",
        "    }",
        "}"
    ],
    "uninstaller": {
        "script": [
            "Write-Output \"`nRemoving '$(friendly_path \"$dir\\bin\")' from $(if ($global) { 'global' } else { 'your' }) path...\"",
            "Remove-Path -Path \"$dir\\bin\" -Global:$global -Quiet -Force",
            "$unregister_installed_file = '\"{0}\\unregister-installed-program.reg\"' -f $dir",
            "Start-Process -FilePath 'reg.exe' -ArgumentList @('import', $unregister_installed_file) -WindowStyle Hidden -Wait",
            "if ($cmd -eq 'uninstall') {",
            "    Get-ChildItem -Path $dir -Filter 'un*.reg' -File |",
            "            Where-Object -FilterScript { $_.BaseName -notmatch 'installed' } | ForEach-Object -Process {",
            "        $registry_file = '\"{0}\"' -f $_.FullName",
            "        Start-Process -FilePath 'reg.exe' -ArgumentList @('import', $registry_file) -WindowStyle Hidden -Wait",
            "    }",
            "}",
            "unlink_persist_data @{ persist = @('data') } $dir"
        ]
    },
    "post_uninstall": [
        "$shortcut_file = Get-AbsolutePath -Path \"$(shortcut_folder $global)\\Visual Studio Code - Insiders.lnk\"",
        "Write-Output \"`nRemoving shortcut '$(friendly_path $shortcut_file)'...\"",
        "Remove-Item -LiteralPath $shortcut_file -Force -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "url": "https://update.code.visualstudio.com/api/update/win32-x64-archive/insider/latest",
        "script": [
            "$release = $page | ConvertFrom-Json -ErrorAction Stop",
            "$time = [DateTimeOffset]::FromUnixTimeMilliseconds($release.timestamp)",
            "Write-Output \"$($release.url), $($time.Year).$($time.DayOfYear).$($time.Hour).$($time.Minute)\""
        ],
        "regex": "insider/(?<commit>[^/]+)/VSCode-win32-x64-(?<prefix>[\\d.]+)[^\\d]+(?<suffix>[\\d.]+)",
        "replace": "${prefix}-${suffix}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://vscode.download.prss.microsoft.com/dbazure/download/insider/$matchCommit/VSCode-win32-x64-$matchHead-insider.zip",
                "hash": {
                    "url": "https://update.code.visualstudio.com/api/versions/$matchHead-insider/win32-x64-archive/insider",
                    "jsonpath": "$.sha256hash"
                }
            },
            "arm64": {
                "url": "https://vscode.download.prss.microsoft.com/dbazure/download/insider/$matchCommit/VSCode-win32-arm64-$matchHead-insider.zip",
                "hash": {
                    "url": "https://update.code.visualstudio.com/api/versions/$matchHead-insider/win32-arm64-archive/insider",
                    "jsonpath": "$.sha256hash"
                }
            }
        }
    }
}
