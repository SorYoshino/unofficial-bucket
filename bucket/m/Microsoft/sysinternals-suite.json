{
    "version": "2026.11.05",
    "description": "A set of utilities to manage, diagnose, troubleshoot, and monitor a Windows environment.",
    "homepage": "https://learn.microsoft.com/en-us/sysinternals/",
    "license": {
        "identifier": "Freeware",
        "url": "https://learn.microsoft.com/sysinternals/license-terms"
    },
    "architecture": {
        "64bit": {
            "url": "https://download.sysinternals.com/files/SysinternalsSuite.zip#/SysinternalsSuite-2026.11.05-x86_64.7z",
            "hash": "e7f49d1f4477e416b3051636dc44929b20ae025b46a1ee4cd8c1f1e869af6ae6"
        },
        "32bit": {
            "url": "https://download.sysinternals.com/files/SysinternalsSuite.zip#/SysinternalsSuite-2026.11.05-x86_64.7z",
            "hash": "e7f49d1f4477e416b3051636dc44929b20ae025b46a1ee4cd8c1f1e869af6ae6"
        },
        "arm64": {
            "url": "https://download.sysinternals.com/files/SysinternalsSuite-ARM64.zip#/SysinternalsSuite-2026.11.05-aarch64.7z",
            "hash": "f2ec09acc20e6e698b7bffea3abb41ce5c034a3090308a9de3d4415b146c9e1b"
        }
    },
    "pre_install": [
        "if ($architecture -eq 'arm64') { return }",
        "Get-ChildItem -Path $dir -Filter '*.exe' -File | Group-Object -Property {",
        "    $_.BaseName -replace '(?:[^a-z]x)?\\d{2}$', ''",
        "} | Where-Object -FilterScript { $_.Count -gt 1 } | ForEach-Object -Process {",
        "    $_.Group | Sort-Object -Descending -Property @(",
        "        { if ($architecture -eq '64bit') { $_.BaseName -match '64$' } else { $_.BaseName -notmatch '64$' } },",
        "        { if ($architecture -eq '64bit') { $_.BaseName -notmatch 'x86$' } else { $_.BaseName -match 'x86$' } }",
        "    ) | Select-Object -Skip 1 | Remove-Item -Force -ErrorAction SilentlyContinue",
        "}"
    ],
    "installer": {
        "script": [
            "$metadata_file = Get-ChildItem -Path \"$bucketsdir\\$bucket\\scripts\\$app\" -Filter '*.jsonc' -File |",
            "        Select-Object -ExpandProperty FullName -First 1",
            "$shortcut_map = Get-Content -Path $metadata_file -Encoding utf8 | ConvertFrom-Json -AsHashtable",
            "$program_name = $shortcut_map.Keys",
            "Get-ChildItem -Path $dir -Filter '*.exe' -File | ForEach-Object -Process {",
            "    $program_file = $_",
            "    $clean_name = $program_file.BaseName -replace '(?:[^a-z]x)?\\d{2}a?$', ''",
            "    Write-Output \"Creating shim for '$clean_name'...\"",
            "    shim $program_file.FullName $global $clean_name $null",
            "    $program_name | Where-Object -FilterScript { $program_file.BaseName -match [regex]::Escape($_) } | ForEach-Object -Process {",
            "        $shortcut_map[$_].Target = $program_file.FullName",
            "    }",
            "}",
            "$program_name | Where-Object -FilterScript { -not [string]::IsNullOrWhiteSpace($shortcut_map[$_].Target) } | ForEach-Object -Process {",
            "    startmenu_shortcut $shortcut_map[$_].Target $shortcut_map[$_].ShortcutName '/accepteula' $null $global",
            "}"
        ]
    },
    "uninstaller": {
        "script": [
            "Get-ChildItem -Path $dir -Filter '*.exe' -File | ForEach-Object -Process {",
            "    $clean_name = $_.BaseName -replace '(?:[^a-z]x)?\\d{2}a?$', ''",
            "    rm_shim $clean_name $(shimdir $global) $app",
            "}"
        ]
    },
    "post_uninstall": [
        "$shortcut_root = Get-AbsolutePath -Path \"$(shortcut_folder $global)\\SysInternals Suite\"",
        "Write-Output \"`nRemoving SysInternals Suite start menu folder '$(friendly_path $shortcut_root)'...\"",
        "Remove-Item -LiteralPath $shortcut_root -Recurse -Force -ErrorAction SilentlyContinue"
    ],
    "checkver": {
        "url": "https://raw.githubusercontent.com/MicrosoftDocs/sysinternals/live/sysinternals/downloads/sysinternals-suite.md",
        "regex": "ms.date:\\s*(?<month>\\d+)/(?<day>\\d+)/(?<year>\\d+)",
        "replace": "${year}.${month}.${day}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download.sysinternals.com/files/SysinternalsSuite.zip#/SysinternalsSuite-$version-x86_64.7z"
            },
            "32bit": {
                "url": "https://download.sysinternals.com/files/SysinternalsSuite.zip#/SysinternalsSuite-$version-x86_64.7z"
            },
            "arm64": {
                "url": "https://download.sysinternals.com/files/SysinternalsSuite-ARM64.zip#/SysinternalsSuite-$version-aarch64.7z"
            }
        }
    }
}
