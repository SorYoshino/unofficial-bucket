# Default to CRLF for text files since Scoop is a Windows-only tool.
# Files are stored as LF in the Git repo but normalized to CRLF on checkout.
* text=auto eol=crlf

# GitHub platform automations, workflows, and integrations require LF line endings.
# Keep at the bottom to correctly override the global CRLF rule above.
.github/**/*.yml text eol=lf
.github/**/*.yaml text eol=lf
