{
    "##": [
        "This file serves as a dedicated snippet template for demonstrating deep Windows system integration.",
        "It includes examples for file associations, shell context menus, URL protocol handler, and other features.",
        "",
        "Usage Guidelines:",
        "- First, modify descriptive items within the 'notes' field based on the application requirements.",
        "- Next, create a subdirectory named after the application within the 'scripts' folder and add the relevant integration files.",
        "  * Ensure all text files are saved explicitly with UTF-8 without BOM encoding.",
        "  * The naming of these integration files can be referenced from the examples provided in the 'notes' field.",
        "- Finally, customize the automation scripts inside 'post_install' and 'uninstaller' blocks to match actual conditions.",
        "  * For specific implementation details, refer to the manifest structures of 'vscode' and '7-zip-zstd'."
    ],
    "notes": [
        "To register file associations, please execute the following command:",
        "- `reg import \"$dir\\register-file-associations.reg\"`",
        "To register application startup, please execute the following command:",
        "- `reg import \"$dir\\register-startup-entry.reg\"`",
        "To register the context menu entry, please execute the following command:",
        "- `reg import \"$dir\\register-context-menu.reg\"`",
        "To register the URL protocol handler, please execute the following command:",
        "- `reg import \"$dir\\register-url-handler.reg\"`",
        "To register file types in the Windows Explorer 'New' context menu (ShellNew), run the following command:",
        "- `reg import \"$dir\\register-shellnew-filetypes.reg\"`",
        "To register the installed program entry (required for integration with other applications), please execute the following command:",
        "- `reg import \"$dir\\register-installed-program.reg\"`",
        "To register Explorer Property Sheet extensions that add specific metadata tabs to the file Properties dialog, run the following command:",
        "- `reg import \"$dir\\register-propertysheet-extension.reg\"`"
    ],
    "post_install": [
        "$app_dir = $dir -replace '\\\\', '\\\\'",
        "Get-ChildItem -Path \"$bucketsdir\\$bucket\\scripts\\$app\" -Filter '*.reg' -File | ForEach-Object -Process {",
        "    $content = Get-Content -Path $_.FullName -Encoding utf8",
        "    if ($global) { $content = $content -replace 'HKEY_CURRENT_USER', 'HKEY_LOCAL_MACHINE' }",
        "    $content -replace '{{app_dir}}', $app_dir | Set-Content -Path \"$dir\\$($_.Name)\" -Encoding unicode",
        "}"
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -ne 'uninstall') { return }",
            "Get-ChildItem -Path $dir -Filter 'un*.reg' -File | ForEach-Object -Process {",
            "    $registry_file = \"`\"{0}`\"\" -f $_.FullName",
            "    Start-Process -FilePath 'reg.exe' -ArgumentList @('import', $registry_file) -WindowStyle Hidden -Wait",
            "}"
        ]
    }
}
